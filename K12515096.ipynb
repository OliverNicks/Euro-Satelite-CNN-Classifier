    "# your code goes here (preprocess function)\n",
    "def preprocess(data_folder: str) -> tuple[pd.DataFrame, dict]:\n",
    "    image_data = []\n",
    "    label = 0\n",
    "    labels = {}\n",
    "    for root, dirs, files in os.walk(data_folder):\n",
    "        for file in files:\n",
    "            file_path = os.path.join(root, file)\n",
    "            parent_folder = os.path.basename(root)\n",
    "\n",
    "            if parent_folder not in labels:\n",
    "                labels[parent_folder] = label\n",
    "                label += 1\n",
    "\n",
    "            image_data.append({\n",
    "                    'file' : file,\n",
    "                    'file_path' : file_path,\n",
    "                    'label' : labels[parent_folder]\n",
    "                }\n",
    "            )\n",
    "    dataset = pd.DataFrame(image_data)\n",
    "    # dataset.info()\n",
    "    # print(dataset.head())\n",
    "    return (dataset, labels)\n",
    "\n",
    "# print(preprocess('data'))\n",
    "dataset, labels = preprocess('data')\n"
   ]
