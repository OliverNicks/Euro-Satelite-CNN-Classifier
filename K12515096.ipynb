    "# your code goes here (preprocess_test_data)\n",
    "def preprocess_test(data_folder: str) -> pd.DataFrame:\n",
    "    test_set_image_data = []\n",
    "    folder_name = os.path.basename(data_folder)\n",
    "\n",
    "    for filename in os.listdir(data_folder):\n",
    "        if filename.lower().endswith((\".png\", \".jpg\", \".jpeg\", \".webp\")):\n",
    "            test_set_image_data.append({\n",
    "                'folder' : folder_name,\n",
    "                'file_name' : filename\n",
    "            })\n",
    "    test_dataset = pd.DataFrame(test_set_image_data)\n",
    "    return test_dataset\n",
    "        \n",
    "\n",
    "    \n",
    "test_dataset = preprocess_test('public_test_data')\n"
   ]
