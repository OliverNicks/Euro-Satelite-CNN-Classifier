   "source": [
    "# your code goes here\n",
    "\n",
    "num_epochs = 150\n",
    "train_loss, train_acc = [], []\n",
    "val_loss, val_acc = [], []\n",
    "learning_rate = 0.001\n",
    "best_val_loss = float('inf')\n",
    "best_model_params = None\n",
    "patience = 10\n",
    "patience_counter = 0\n",
    "\n",
    "model = SateliteCNN().to(device) \n",
    "criterion = nn.CrossEntropyLoss(label_smoothing=0.1) \n",
    "optimizer = torch.optim.AdamW(model.parameters(), lr=learning_rate, weight_decay=1e-4)\n",
    "scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', patience=6, factor=0.2, threshold=0.005)\n",
    "\n",
    "# === Training Phase ===\n",
    "\n",
    "for epoch in range(num_epochs):\n",
    "    model.train()\n",
    "    running_loss = 0.0\n",
    "    correct = 0.0\n",
    "    total = 0.0\n",
    "    for i, (images, label) in enumerate(train_loader):\n",
    "        images, label = images.to(device), label.to(device)\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "        outputs = model(images)\n",
    "        loss = criterion(outputs, label)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        running_loss += loss.item() * label.size(0)\n",
    "        predicted = outputs.argmax(dim=1)\n",
    "        total += label.size(0)\n",
    "        correct += (predicted == label).sum().item()\n",
    "\n",
    "    epoch_train_loss = running_loss / total\n",
    "    acc = 100 * correct / total\n",
    "\n",
    "# === Validation Phase ===\n",
    "    model.eval()\n",
    "    with torch.no_grad():\n",
    "        running_val_loss = 0.0\n",
    "        val_correct = 0.0\n",
    "        val_total = 0.0\n",
    "        for images, label in test_loader:\n",
    "            images, label = images.to(device), label.to(device)\n",
    "            outputs = model(images)\n",
    "            loss = criterion(outputs, label)\n",
    "            running_val_loss += loss.item() * label.size(0)\n",
    "            predicted = outputs.argmax(dim=1)\n",
    "            val_total += label.size(0)\n",
    "            val_correct += (predicted == label).sum().item()\n",
    "\n",
    "\n",
    "    epoch_val_loss = running_val_loss / val_total\n",
    "    epoch_val_acc = 100 * val_correct / val_total\n",
    "\n",
    "    train_loss.append(epoch_train_loss)\n",
    "    train_acc.append(acc)\n",
    "    val_loss.append(epoch_val_loss)\n",
    "    val_acc.append(epoch_val_acc)\n",
    "\n",
    "    scheduler.step(epoch_val_loss)\n",
    "    current_lr = optimizer.param_groups[0]['lr']\n",
    "\n",
    "    # === Tracking Progress ===\n",
    "\n",
    "    print(f'================= Epoch {epoch + 1}/{num_epochs} =================')\n",
    "    print(f'Train Loss: {epoch_train_loss:.4f} | Train Accuracy: {acc:.2f}')\n",
    "    print(f'Validation Loss: {epoch_val_loss:.4f} | Validation Accuracy: {epoch_val_acc:.2f}')\n",
    "    print(f'Learning Rate: {current_lr}')\n",
    "\n",
    "    # === Updating Weights ===\n",
    "\n",
    "    if epoch_val_loss < best_val_loss:\n",
    "        best_val_loss = epoch_val_loss\n",
    "        best_model_params = copy.deepcopy(model.state_dict())\n",
    "        os.makedirs('saves', exist_ok=True)\n",
    "        torch.save(best_model_params, os.path.join('saves', 'best_model_satellite.pth'))\n",
    "        patience_counter = 0\n",
    "        print('New Val_loss. Weights updated.')\n",
    "\n",
    "    # === Early Stopping block ===\n",
    "    else:\n",
    "        patience_counter += 1\n",
    "        print('No imrovement')\n",
    "        if patience_counter >= patience:\n",
    "            print('\\n Early stoping triggered!')\n",
    "            break\n",
    "\n",
    "\n",
    "if best_model_params is not None:\n",
    "    model.load_state_dict(best_model_params)\n",
    "    print('\\n Stored model parametrs')\n"
   ]
